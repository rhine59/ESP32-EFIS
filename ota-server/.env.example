# Copy to .env on the Synology; never commit the real .env.
OTA_PUBLIC_BASE_URL=https://granvillehouse.synology.me:8448
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET

# Ed25519 private key must remain on the Synology and outside the repository.
OTA_SIGNING_KEY_ID=redone-v2
OTA_SIGNING_KEY_FILE=/volume1/homes/chatgpt/redone-signing/redone-v2.pem
