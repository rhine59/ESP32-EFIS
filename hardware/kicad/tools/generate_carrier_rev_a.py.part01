def two_pad(ref,val,x,y,n1,n2,size=(3.2,1.6),padsize=(1.2,1.2)):
    px=size[0]/2-0.6
    pads=[pad(1,'smd','rect',x-px,y,padsize[0],padsize[1],'"F.Cu" "F.Paste" "F.Mask"',n1),pad(2,'smd','rect',x+px,y,padsize[0],padsize[1],'"F.Cu" "F.Paste" "F.Mask"',n2)]
    return fp_generic(ref,val,x,y,pads,size)
