def sym_def(name,ref_prefix,pin_names):
    n=len(pin_names); left=(n+1)//2; right=n-left; h=max(left,right)*2.54+5
    s=[f'    (symbol "AH:{name}" (pin_names (offset 1.0)) (exclude_from_sim no) (in_bom yes) (on_board yes)',
       f'      (property "Reference" "{ref_prefix}" (at 0 {-h/2-2:.2f} 0) (effects (font (size 1.27 1.27))))',
       f'      (property "Value" "{name}" (at 0 {h/2+2:.2f} 0) (effects (font (size 1.27 1.27))))',
       '      (property "Footprint" "" (at 0 0 0) (effects (font (size 1.27 1.27)) hide))',
       '      (property "Datasheet" "" (at 0 0 0) (effects (font (size 1.27 1.27)) hide))',
       f'      (symbol "{name}_0_1" (rectangle (start -10 {-h/2:.2f}) (end 10 {h/2:.2f}) (stroke (width 0.254) (type default)) (fill (type background))))',
       f'      (symbol "{name}_1_1"']
    for i,(num,pname) in enumerate(pin_names):
        if i<left:
            y=-((left-1)/2)*2.54+i*2.54; x=-12.54; ang=0
        else:
            j=i-left; y=-((right-1)/2)*2.54+j*2.54; x=12.54; ang=180
        s.append(f'        (pin passive line (at {x:.2f} {y:.2f} {ang}) (length 2.54) (name "{pname}" (effects (font (size 1.0 1.0)))) (number "{num}" (effects (font (size 1.0 1.0)))))')
    s+=['      )','    )']
    return '\n'.join(s),left,right,h
