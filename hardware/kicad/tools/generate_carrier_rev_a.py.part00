for n,g in project_gpio.items(): u1net[module_gpio_pad[g]]=n
u1=['  (footprint "Espressif:ESP32-S3-WROOM-1" (layer "F.Cu") (uuid '+U()+')',prop_ref('U1',ux,uy-17.3),prop_val('ESP32-S3-WROOM-1-N16R2',ux,uy+12),
    f'    (fp_rect (start {ux-9:.3f} {uy-15.75:.3f}) (end {ux+9:.3f} {uy+9.75:.3f}) (stroke (width 0.15) (type default)) (fill none) (layer "F.SilkS") (uuid {U()}))',
    f'    (fp_rect (start {ux-9:.3f} {uy-15.75:.3f}) (end {ux+9:.3f} {uy-9.81:.3f}) (stroke (width 0.15) (type default)) (fill none) (layer "Dwgs.User") (uuid {U()}))']
for p,(x,y,r) in u1pads.items(): u1.append(pad(p,'smd','rect',x,y,1.5,0.9,'"F.Cu" "F.Paste" "F.Mask"',u1net.get(p),rot=r))
