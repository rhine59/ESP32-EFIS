def prop_ref(ref,x,y,hide=False):
    h=' hide' if hide else ''
    return f'''    (property "Reference" "{ref}" (at {x:.3f} {y:.3f} 0) (layer "F.SilkS"){h}\n      (effects (font (size 1 1) (thickness 0.15)))\n    )'''
def prop_val(val,x,y):
    return f'''    (property "Value" "{val}" (at {x:.3f} {y:.3f} 0) (layer "F.Fab") hide\n      (effects (font (size 1 1) (thickness 0.15)))\n    )'''
def net_clause(n): return '' if not n else f' (net {netid[n]} "{n}")'
def pad(num,kind,shape,x,y,sx,sy,layers,n=None,drill=None,rot=0):
    dr=f' (drill {drill})' if drill else ''
    return f'    (pad "{num}" {kind} {shape} (at {x:.3f} {y:.3f} {rot}) (size {sx:.3f} {sy:.3f}){dr} (layers {layers}){net_clause(n)} (uuid {U()}))'
def fp_generic(ref,val,x,y,pads,body=(10,6)):
    bx,by=body
    s=[f'  (footprint "AH:{val}" (layer "F.Cu") (at 0 0) (uuid {U()})',prop_ref(ref,x,y-by/2-1.5),prop_val(val,x,y+by/2+1.5),
       f'    (fp_rect (start {x-bx/2:.3f} {y-by/2:.3f}) (end {x+bx/2:.3f} {y+by/2:.3f}) (stroke (width 0.15) (type default)) (fill none) (layer "F.SilkS") (uuid {U()}))']
    for p in pads: s.append(p)
    s.append('  )')
    return '\n'.join(s)
