        pu=U(); pins.append((num,pu))
        if i<left:
            yy=y-((left-1)/2)*2.54+i*2.54; xx=x-12.54
        else:
            j=i-left; yy=y-((right-1)/2)*2.54+j*2.54; xx=x+12.54
        endpoints.append((num,pname,xx,yy))
        s.append(f'    (pin "{num}" (uuid {pu}))')
    s+=['    (instances','      (project "carrier_rev_a"',f'        (path "/ROOTUUID" (reference "{ref}") (unit 1) (value "{val}") (footprint "{footprint}"))','      )','    )','  )']
    return '\n'.join(s),endpoints
