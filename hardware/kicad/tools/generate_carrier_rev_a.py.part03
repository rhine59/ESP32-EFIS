def epdict(ep): return {num:(x,y) for num,name,x,y in ep}
def label(name,p):
    return f'  (label "{name}" (at {p[0]:.2f} {p[1]:.2f} 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid {U()}))'
