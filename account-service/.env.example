POSTGRES_DB=efis_accounts
POSTGRES_USER=efis
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SESSION_SECRET
# Private signer endpoint only; never expose signer publicly.
LICENSE_SIGNER_URL=

# Public account-service URL used to build email verification links.
PUBLIC_BASE_URL=https://granvillehouse.synology.me:8450
# Transactional SMTP. Keep real credentials only in runtime .env.
SMTP_HOST=CHANGE_ME
SMTP_PORT=465
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=CHANGE_ME
SMTP_SSL=1
EMAIL_VERIFY_MINUTES=30
